# Copy to .env and fill in real values. .env is gitignored -- never commit real keys.
# run.sh loads .env automatically.

# Required for Stage 1 (evidence gathering, tool-calling, routing) and for Stage 2
# when STAGE2_BACKEND=anthropic (fallback path).
ANTHROPIC_API_KEY=

# Optional -- defaults to claude-haiku-4-5-20251001 if unset.
# ANTHROPIC_MODEL=

# Required for Stage 2 (bulk rationale synthesis) unless STAGE2_BACKEND=anthropic.
OPENCODE_API_KEY=

# Optional -- backend for Stage 2. "opencode-go" (default, DeepSeek V4 Pro, cheaper)
# or "anthropic" (fallback if opencode-go is unreachable).
# STAGE2_BACKEND=opencode-go

# Optional -- defaults to deepseek-v4-flash if unset. deepseek-v4-pro is a heavy
# reasoning model that did not converge within a reasonable token budget on this
# project's prompts (confirmed via live testing -- burned 6000+ completion tokens on
# hidden reasoning_content with zero actual answer). deepseek-v4-flash produces valid,
# well-grounded output reliably and is a better fit for Stage 2's bulk-generation role.
# STAGE2_MODEL=

# Optional -- defaults to https://opencode.ai/zen/go/v1 if unset.
# OPENCODE_BASE_URL=

# Optional -- defaults to 6000 if unset. Reasoning-style opencode-go models spend
# completion tokens on hidden reasoning before the actual answer; too low a budget
# produces empty output (finish_reason="length").
# STAGE2_MAX_TOKENS=

# Set to 1 to run the full pipeline with deterministic canned rationales and zero
# API calls (no keys required). Useful for tests and a zero-setup demo.
# MOCK_LLM=1
