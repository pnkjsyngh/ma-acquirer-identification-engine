# Copy to .env and fill in real values. .env is gitignored -- never commit real keys.
# run.sh loads .env automatically.

# Required for Stage 1 (evidence gathering, tool-calling, routing) and for Stage 2
# when STAGE2_BACKEND=anthropic (fallback path).
ANTHROPIC_API_KEY=

# Optional -- defaults to claude-haiku-4-5-20251001 if unset.
# ANTHROPIC_MODEL=

# Required for Stage 2 (bulk rationale synthesis) unless STAGE2_BACKEND=anthropic.
OPENCODE_API_KEY=

# Optional -- backend for Stage 2. "opencode-go" (default, cheaper) or "anthropic"
# (fallback if opencode-go is unreachable).
# STAGE2_BACKEND=opencode-go

# Optional -- defaults to gpt-5.6-luna if unset. deepseek-v4-pro and deepseek-v4-flash
# (also available via opencode-go) are reasoning models with no documented way to
# cap/disable hidden reasoning -- confirmed via live testing that both burn their
# entire completion-token budget on unused reasoning_content with zero actual answer.
# gpt-5.6-luna produces zero reasoning overhead and converges reliably.
# STAGE2_MODEL=

# Optional -- defaults to https://opencode.ai/zen/go/v1 if unset.
# OPENCODE_BASE_URL=

# Optional -- defaults to 3500 if unset. Only matters if you switch STAGE2_MODEL to a
# reasoning-style model, which needs real headroom for hidden reasoning tokens before
# the visible answer (too low a budget produces empty output, finish_reason="length").
# STAGE2_MAX_TOKENS=

# Set to 1 to run the full pipeline with deterministic canned rationales and zero
# API calls (no keys required). Useful for tests and a zero-setup demo.
# MOCK_LLM=1

# Optional -- Langfuse tracing (cloud.langfuse.com, free tier). Read automatically by
# the langfuse SDK -- no custom env-var handling in this codebase. Entirely optional:
# tracing is only enabled when LANGFUSE_PUBLIC_KEY is set, everything else (including
# MOCK_LLM=1) runs identically without it.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
